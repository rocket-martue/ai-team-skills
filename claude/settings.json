{
  "permissions": {
    "allow": [
      "Edit(docs/tasks/**)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(git show:*)",
      "Bash(vendor/bin/phpcs:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(gh pr:*)"
    ],
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.kv/**)",
      "Read(**/wp-config.php)",
      "Read(**/.env*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-code-edit.mjs\""
          }
        ]
      }
    ]
  }
}
