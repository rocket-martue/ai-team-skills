{
  "permissions": {
    "allow": [
      "Edit(docs/tasks/**)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git fetch origin)",
      "Bash(gh repo view:*)",
      "Bash(git show:*)",
      "Bash(vendor/bin/phpcs:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/skills/codex/scripts/invoke-codex.ps1:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git branch:*)",
      "Bash(git worktree remove:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git --no-pager:*)",
      "Bash(gh pr:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git worktree remove:*)",
      "PowerShell(git -C:*)",
      "PowerShell(git -c:*)",
      "PowerShell(git --git-dir*)",
      "PowerShell(git --work-tree*)",
      "PowerShell(git --no-pager:*)",
      "PowerShell(gh pr:*)"
    ],
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.kv/**)",
      "Read(**/wp-config.php)",
      "Read(**/.env*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git reset:*)",
      "PowerShell(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-code-edit.mjs"]
          }
        ]
      }
    ]
  }
}
