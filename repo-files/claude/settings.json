{
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git fetch origin)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr ls:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(git remote get-url:*)",
      "PowerShell(gh pr list:*)",
      "PowerShell(gh pr ls:*)",
      "PowerShell(gh pr view:*)",
      "PowerShell(gh pr diff:*)",
      "PowerShell(gh pr checks:*)",
      "PowerShell(gh pr status:*)",
      "PowerShell(git remote get-url:*)"
    ],
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.kv/**)",
      "Read(**/wp-config.php)",
      "Read(**/.env*)",
      "Bash(git show *wp-config.php*)",
      "Bash(git show *.env*)",
      "Bash(git show *.dev.vars*)",
      "Bash(git show *.kv/*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(git show *wp-config.php*)",
      "PowerShell(git show *.env*)",
      "PowerShell(git show *.dev.vars*)",
      "PowerShell(git show *.kv/*)",
      "PowerShell(git diff *--output*)",
      "PowerShell(git log *--output*)",
      "PowerShell(git show *--output*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git reset:*)",
      "PowerShell(gh pr merge:*)"
    ]
  }
}
